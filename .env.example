# ═══════════════════════════════════════════════════════════════════════════════
# NEXUS — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# ─── Quick Start ───
# 1. Create a free Supabase project -> copy URL + anon key + service_role key
# 2. Start local Redis -> docker run -d -p 6379:6379 redis:7-alpine
# 3. (Optional) Start Ollama -> ollama pull llama3.2 && ollama pull nomic-embed-text
# 4. Run: npm run migrate && npm run seed
# 5. Run: npm run dev
# ═══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
#  REQUIRED — App won't start without these
# ──────────────────────────────────────────────

# Supabase project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (for admin operations & the AI worker)
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
#  AUTH
# ──────────────────────────────────────────────

# Site URL for auth redirects (default: http://localhost:3000)
# NEXT_PUBLIC_SITE_URL=

# ──────────────────────────────────────────────
#  UPSTASH — Required for shared rate limiting (Vercel / multi-instance)
# ──────────────────────────────────────────────

# Get these from https://console.upstash.com/redis
# Only needed if deploying on Vercel or multiple instances.
# For single-instance Docker, rate limiting uses in-memory (no config needed).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────────
#  REDIS — Required for BullMQ job queue
# ──────────────────────────────────────────────

# Redis server hostname (default: localhost)
REDIS_HOST=localhost

# Redis server port (default: 6379)
REDIS_PORT=6379

# Redis auth password (leave blank if none)
# REDIS_PASSWORD=

# Redis database number (default: 0)
# REDIS_DB=0

# Enable TLS for managed Redis providers like Upstash, Redis Cloud
# Set to "true" if using a remote Redis host (auto-detected for non-local hosts)
# REDIS_TLS=true

# Redis connection string (alternative to REDIS_HOST/PORT/PASSWORD)
# Used primarily for Vercel or production deployments
# REDIS_URL=

# ──────────────────────────────────────────────
#  AI PIPELINE — Required for search & embeddings
# ──────────────────────────────────────────────

# Ollama API URL (default: http://localhost:11434)
# Dev: http://localhost:11434
# Prod: https://your-ollama-server:11434
OLLAMA_URL=http://localhost:11434

# Text generation model (default: llama3.2)
# Change to any model pulled locally: ollama pull <model>
# OLLAMA_MODEL=llama3.2

# Embedding model (default: nomic-embed-text)
# Must match the VECTOR_DIMENSION below
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ollama fetch timeout in milliseconds (default: 30000)
# Increase for slower hardware or larger models
# OLLAMA_TIMEOUT=30000

# Max tokens per AI response (default: 1024)
# OLLAMA_NUM_PREDICT=1024

# Model temperature 0.0-1.0 — higher = more creative (default: 0.3)
# OLLAMA_TEMPERATURE=0.3

# ──────────────────────────────────────────────
#  QUEUE & BACKFILL — Optional (defaults shown)
# ──────────────────────────────────────────────

# Cron schedule for backfill scanning (default: */15 * * * *)
# BACKFILL_CRON=*/15 * * * *

# Items per backfill scan batch (default: 200)
# BACKFILL_BATCH=200

# Set to "false" to disable automatic backfill (default: true)
# BACKFILL_ENABLED=true

# Number of AI jobs to process concurrently per worker (default: 2)
# WORKER_CONCURRENCY=2

# Max jobs per limiter window — controls how fast jobs start (default: 4)
# Increase to allow burst processing when concurrency is high
# WORKER_LIMITER_MAX=4

# Limiter window in milliseconds — together with WORKER_LIMITER_MAX
# controls the job start rate (default: 30000 = 30s)
# WORKER_LIMITER_DURATION=30000

# Worker polling interval in milliseconds
# WORKER_POLL_INTERVAL=

# Health check HTTP server port for Docker HEALTHCHECK (default: 9090)
# Set to 0 to disable the health check server
# WORKER_HEALTH_PORT=9090

# How often to check for stalled workers in milliseconds (default: 60000)
# Increase if jobs take longer than 2 minutes to avoid false positives
# WORKER_STALLED_INTERVAL=60000

# Max job processing time before considering it stalled in ms (default: 120000)
# Must be larger than the longest expected AI processing job
# WORKER_LOCK_DURATION=120000

# How long to keep completed jobs in Redis (default: 1 hour)
# Lower = less memory usage. Higher = better debugging.
# JOB_RETAIN_COMPLETE_HOURS=1

# How long to keep failed jobs in Redis (default: 24 hours)
# JOB_RETAIN_FAIL_HOURS=24

# AI pipeline batch size — items processed together in batch jobs (default: 3)
# AI_BATCH_SIZE=3

# Max existing items to compare against for connection discovery (default: 20)
# Increase for better connections in large datasets, decrease for faster processing
# AI_CONNECTION_LIMIT=20

# Embedding vector dimension — matches your Ollama model output (default: 768)
# VECTOR_DIMENSION=768

# ──────────────────────────────────────────────
#  NOTIFICATIONS — Optional for critical alerts
# ──────────────────────────────────────────────

# Slack incoming webhook URL
# SLACK_WEBHOOK_URL=

# Discord webhook URL
# DISCORD_WEBHOOK_URL=

# Resend.com API key for email notifications
# RESEND_API_KEY=

# Alert recipient email address
# ALERT_EMAIL_TO=

# Alert sender email (default: NEXUS Alerts <alerts@nexus.app>)
# ALERT_EMAIL_FROM=

# Notification cooldowns in minutes — prevent alert spam (defaults: 30 each)
# Used as fallback when no Redis config is saved. Clamped to 1-1440.
# NOTIFY_COOLDOWN_SLACK=30
# NOTIFY_COOLDOWN_DISCORD=30
# NOTIFY_COOLDOWN_EMAIL=30

# ──────────────────────────────────────────────
#  POSTGRES — For LISTEN/NOTIFY support
# ──────────────────────────────────────────────

# Full Postgres connection string (e.g. postgresql://user:pass@host:5432/db)
# Required if you want the AI worker to use LISTEN/NOTIFY for real-time item processing
# DATABASE_URL=

# ──────────────────────────────────────────────
#  DEPLOYMENT
# ──────────────────────────────────────────────

# Override URL for notification links and status checks
# NEXUS_URL=

# Skip Redis entirely — returns a no-op connection. Use during builds where
# Redis isn't available (e.g. Vercel Preview deployments). Queues will not
# function, but the app will build and run.
# SKIP_REDIS=true

# Redis hostname for status page display (when different from REDIS_HOST)
# NEXT_PUBLIC_REDIS_HOST=

# Set to "standalone" for Docker builds (next.config.js reads this)
# BUILD_TARGET=
